# copy to .env and put your mysql details
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_retail

# 0.0.0.0 to open it from a phone on the same wifi
APP_HOST=127.0.0.1
APP_PORT=5000

# code needed on /signup (left empty = random one saved in .signup_code)
SIGNUP_CODE=

# hosted mysql (Aiven etc): DB_SSL=1, and INIT_DB_ON_START=1 to create tables under gunicorn
DB_SSL=
INIT_DB_ON_START=
